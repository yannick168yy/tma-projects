# ── MySQL ──────────────────────────────────────────
MYSQL_ROOT_PASSWORD=root_dev_only
MYSQL_DATABASE=tma
MYSQL_USER=tma
MYSQL_PASSWORD=tma_dev
MYSQL_PORT=3306

# ── Redis ──────────────────────────────────────────
REDIS_PORT=6379
REDIS_MAXMEMORY=128mb

# ── NATS JetStream ─────────────────────────────────
NATS_PORT=4222
NATS_MONITOR_PORT=8222

# ── BetoGo 客户端 (web-tma, Nginx) ─────────────────
WEB_TMA_PORT=8080
VITE_BFF_BASE_URL=http://localhost:3000/api/v1
VITE_USE_MOCK_API=false
VITE_GOOGLE_CLIENT_ID=your_google_client_id
VITE_GOOGLE_REDIRECT_URI=https://www.188facai.com/auth/google/callback
VITE_TELEGRAM_BOT_USERNAME=BetoGoBot
VITE_TELEGRAM_WEB_APP_URL=https://www.188facai.com

# ── BFF Node ───────────────────────────────────────
BFF_STORAGE=mysql

# ── Matrix 加密支付通道 ─────────────────────────────────────────────────────
# DEV 网关示例：https://bs.dev.global-gateway-api-service-web3-app.cc/api
MATRIX_GATEWAY_URL=https://{gateway-host}/api
MATRIX_API_KEY=your_matrix_api_key
MATRIX_MERCHANT_NO=your_merchant_no
MATRIX_MERCHANT_API_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
MATRIX_PLATFORM_API_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----
MATRIX_MERCHANT_NOTIFY_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
MATRIX_PLATFORM_NOTIFY_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----
MATRIX_NOTIFY_URL=https://api.yourdomain.com/api/v1/callback/matrix
MATRIX_WITHDRAW_CHECK_URL=https://api.yourdomain.com/api/v1/callback/matrix/withdraw-check
BFF_PORT=3000
LOG_LEVEL=info

# ── 日志栈（deploy/single-node/start-observability.sh）──
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme
NGINX_LOG_DIR=/www/wwwlogs
TELEGRAM_BOT_TOKEN=your_bot_token_here
AMMER_PAY_PROVIDER_TOKEN=your_ammer_pay_provider_token
USDT_TO_PHP_RATE=58

# ── YF Pay ─────────────────────────────────────────
YFPAY_USERNAME=your_yfpay_username
YFPAY_API_KEY=your_yfpay_api_key
YFPAY_NOTIFY_URL=https://www.188facai.com/api/v1/callback/yfpay

# ── BeePay ─────────────────────────────────────────
BEEPAY_BASE_URL=https://gateway.beepay.example.com
BEEPAY_MID_NO=your_beepay_mid_no
BEEPAY_API_KEY=your_beepay_api_key
BEEPAY_NOTIFY_URL=https://www.188facai.com/api/v1/callback/beepay
BFF_DEV_SKIP_TELEGRAM_AUTH=true
SESSION_TTL_SECONDS=86400
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=https://www.188facai.com/auth/google/callback

# ── MySQL（Docker 服务名 mysql；生产容器 :13306）──
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=betogo
MYSQL_BETOGO_USER=betogo
MYSQL_BETOGO_PASSWORD=betogo_dev
MYSQL_PASSWORD=betogo_dev

# ── Core Node ──────────────────────────────────────
CORE_PORT=4000
NATS_URL=nats://nats:4222
NATS_STREAM=BETOGO
NATS_LEDGER_SUBJECT=betogo.ledger
NATS_CALLBACK_SUBJECT=betogo.callback

