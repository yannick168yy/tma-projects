# ── MySQL ──────────────────────────────────────────
# 生产：宝塔 3306 库名 betogo（见 deploy/mysql/create-betogo-database.sql）
MYSQL_ROOT_PASSWORD=root_dev_only
MYSQL_DATABASE=tma
MYSQL_USER=tma
MYSQL_PASSWORD=tma_dev
MYSQL_PORT=3306

# ── Redis ──────────────────────────────────────────
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_MAXMEMORY=128mb

# ── RabbitMQ ───────────────────────────────────────
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
RABBITMQ_USER=tma
RABBITMQ_PASSWORD=tma_dev

# ── BetoGo 客户端 (web-tma, Nginx) ─────────────────
WEB_TMA_PORT=8080
VITE_BFF_BASE_URL=http://localhost:3000/api/v1
VITE_USE_MOCK_API=false
VITE_GOOGLE_CLIENT_ID=1054807290396-ue8av2fcveh947fb71k93n2mobh3v3gk.apps.googleusercontent.com
VITE_GOOGLE_REDIRECT_URI=https://www.188facai.com/auth/google/callback
VITE_TELEGRAM_BOT_USERNAME=BetoGoBot
VITE_TELEGRAM_WEB_APP_URL=https://www.188facai.com

# ── Node BFF ───────────────────────────────────────
# mysql = 用户/钱包/订单；redis = 仅 Session（与 MYSQL 容器同栈）
BFF_STORAGE=mysql
BFF_PORT=3000
TELEGRAM_BOT_TOKEN=your_bot_token_here
AMMER_PAY_PROVIDER_TOKEN=your_ammer_pay_provider_token
USDT_TO_PHP_RATE=58
BFF_DEV_SKIP_TELEGRAM_AUTH=true
SESSION_TTL_SECONDS=86400
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=https://www.188facai.com/auth/google/callback

# ── MySQL（Docker 服务名 mysql；生产容器 :13306）──
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=betogo
MYSQL_BETOGO_USER=betogo
MYSQL_BETOGO_PASSWORD=betogo_dev
MYSQL_PASSWORD=betogo_dev

# ── Nacos（可选；LOCAL_DEPLOY_FULL=1 或 4G+ 机器）────
NACOS_PORT=8848
NACOS_SERVER_ADDR=
NACOS_NAMESPACE=batogo

# ── Java Core (待定, docker compose --profile java) ─
CORE_JAVA_PORT=8080
