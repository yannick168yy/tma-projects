# ── MySQL ──────────────────────────────────────────
# 生产：宝塔 3306 库名 betogo（见 deploy/mysql/create-betogo-database.sql）
MYSQL_ROOT_PASSWORD=root_dev_only
MYSQL_DATABASE=tma
MYSQL_USER=tma
MYSQL_PASSWORD=tma_dev
MYSQL_PORT=3306

# ── Redis ──────────────────────────────────────────
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_MAXMEMORY=128mb

# ── RabbitMQ ───────────────────────────────────────
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
RABBITMQ_USER=tma
RABBITMQ_PASSWORD=tma_dev

# ── BetoGo 客户端 (web-tma, Nginx) ─────────────────
WEB_TMA_PORT=5173
VITE_BFF_BASE_URL=http://localhost:3000/api/v1
VITE_USE_MOCK_API=false
VITE_GOOGLE_CLIENT_ID=1054807290396-ue8av2fcveh947fb71k93n2mobh3v3gk.apps.googleusercontent.com
VITE_GOOGLE_REDIRECT_URI=https://www.188facai.com/auth/google/callback
VITE_TELEGRAM_BOT_USERNAME=BetoGoBot
VITE_TELEGRAM_WEB_APP_URL=https://www.188facai.com

# ── Node BFF ───────────────────────────────────────
BFF_PORT=3000
TELEGRAM_BOT_TOKEN=your_bot_token_here
AMMER_PAY_PROVIDER_TOKEN=your_ammer_pay_provider_token
USDT_TO_PHP_RATE=58
BFF_DEV_SKIP_TELEGRAM_AUTH=true
SESSION_TTL_SECONDS=86400
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=https://www.188facai.com/auth/google/callback

# ── Nacos（同机 Docker，namespace: batogo）──────────
NACOS_PORT=8848
NACOS_SERVER_ADDR=127.0.0.1:8848
NACOS_NAMESPACE=batogo

# ── Java Core (待定, docker compose --profile java) ─
CORE_JAVA_PORT=8080
