# ── MySQL ──────────────────────────────────────────
MYSQL_ROOT_PASSWORD=root_dev_only
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=betogo
MYSQL_BETOGO_USER=betogo
MYSQL_BETOGO_PASSWORD=betogo_dev
MYSQL_USER=betogo
MYSQL_PASSWORD=betogo_dev

# ── Redis ──────────────────────────────────────────
REDIS_PORT=6379
REDIS_MAXMEMORY=128mb

# ── NATS JetStream ─────────────────────────────────
NATS_PORT=4222
NATS_MONITOR_PORT=8222

# ── BetoGo 客户端 (web-tma, Nginx) ─────────────────
WEB_TMA_PORT=8080
VITE_BFF_BASE_URL=http://localhost:3000/api/v1
VITE_USE_MOCK_API=false
VITE_GOOGLE_CLIENT_ID=your_google_client_id
VITE_GOOGLE_REDIRECT_URI=https://www.188facai.com/auth/google/callback
VITE_TELEGRAM_BOT_USERNAME=BetoGoBot
VITE_TELEGRAM_WEB_APP_URL=https://www.188facai.com

# ── BFF Node ───────────────────────────────────────
BFF_STORAGE=mysql

# ── Matrix 加密支付通道 ─────────────────────────────────────────────────────
# DEV 网关示例：https://bs.dev.global-gateway-api-service-web3-app.cc/api
MATRIX_GATEWAY_URL=https://{gateway-host}/api
MATRIX_API_KEY=your_matrix_api_key
MATRIX_MERCHANT_NO=your_merchant_no
MATRIX_MERCHANT_API_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
MATRIX_PLATFORM_API_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----
MATRIX_MERCHANT_NOTIFY_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
MATRIX_PLATFORM_NOTIFY_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----
MATRIX_NOTIFY_URL=https://api.yourdomain.com/api/v1/callback/matrix
MATRIX_WITHDRAW_CHECK_URL=https://api.yourdomain.com/api/v1/callback/matrix/withdraw-check
BFF_PORT=3000
LOG_LEVEL=info

# ── 日志栈（deploy/single-node/start-observability.sh）──
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme
NGINX_LOG_DIR=/www/wwwlogs
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_OIDC_CLIENTS=betogo666.com=client_id:client_secret,betogo777.com=client_id:client_secret
AMMER_PAY_PROVIDER_TOKEN=your_ammer_pay_provider_token
# Telegram webhook 验签密钥：setWebhook 时用 secret_token 设为同值,
# Telegram 回调会带 X-Telegram-Bot-Api-Secret-Token 头,bff 校验防伪造 successful_payment
TELEGRAM_WEBHOOK_SECRET=
USDT_TO_PHP_RATE=58
IDR_TO_PHP_RATE=0.0034843206
MARKET_DOMAIN_MAP={"betogo666.com":"PH","betogo777.com":"PH","betogo.ph":"PH","betogo.xyz":"ID","betogo.vip":"ID","betogo888.com":"ID","betogo.cc":"ID","betogo.games":"ID","www.betogo.games":"ID"}

# ── YF Pay ─────────────────────────────────────────
YFPAY_USERNAME=your_yfpay_username
YFPAY_API_KEY=your_yfpay_api_key
YFPAY_NOTIFY_URL=https://www.188facai.com/api/v1/callback/yfpay

# ── BeePay ─────────────────────────────────────────
BEEPAY_BASE_URL=https://gateway.beepay.example.com
BEEPAY_MID_NO=your_beepay_mid_no
BEEPAY_API_KEY=your_beepay_api_key
BEEPAY_NOTIFY_URL=https://www.188facai.com/api/v1/callback/beepay
BFF_DEV_SKIP_TELEGRAM_AUTH=true
SESSION_TTL_SECONDS=86400
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=https://www.188facai.com/auth/google/callback

# ── Core Node ──────────────────────────────────────
CORE_PORT=4000
NATS_URL=nats://nats:4222
NATS_STREAM=BETOGO
NATS_LEDGER_SUBJECT=betogo.ledger
NATS_CALLBACK_SUBJECT=betogo.callback

# ── 568Win ────────────────────────────────────────
WIN568_BASE_URL=https://test-api.568win.com
WIN568_COMPANY_KEY=
WIN568_SERVER_ID=
WIN568_SW_COMPANY_KEY=
WIN568_SW_ALLOWED_IPS=122.146.58.49,61.220.125.7,61.220.125.8,220.130.194.76,111.235.225.61,111.235.225.62,125.227.48.247,125.227.48.248,136.228.131.134,163.47.15.15,103.60.253.249,103.60.255.247,15.152.236.209,15.152.26.49,203.176.129.162,103.60.252.203,103.60.252.250,103.60.253.203,103.60.254.250,103.60.254.203,103.60.255.203,203.57.34.203,203.57.35.203,103.60.252.204,103.60.253.205,103.60.253.221,43.198.1.150,15.152.117.63,43.218.41.172,52.194.35.1,34.92.69.111,34.80.140.183,34.96.190.70,34.95.200.210
WIN568_DEFAULT_CURRENCY=PHP

# ── 包网平台层 ─────────────────────────────────────
# 平台库里第三方凭据（聚合商子代理密钥、支付通道 API key）的加密主密钥。
# 32 字节的 base64 或 hex：openssl rand -base64 32
# 🔴 不配就存不了凭据（会直接报错而不是以明文落库）；换了这把 key 已存的凭据全部解不开。
PLATFORM_CREDENTIAL_KEY=
# 平台自有根域名：子域名租户用 <code>.<根域名>，走泛解析 + 泛域名证书
PLATFORM_ROOT_DOMAIN=betogo.games
# 本机公网 IP（可逗号分隔），用于判断客户自带域名的 A 记录是否已指过来
SERVER_PUBLIC_IP=
# 未登记域名的兜底：false=回落自营站并告警（观察期），true=直接 404。接第一个客户前必须为 true
TENANT_RESOLVE_STRICT=false

# P3-6 跨租户风控联防的哈希盐（32 字节随机串，hex 或任意 >=16 字符）。
# 平台库只存 HMAC 摘要不存明文；不配这把盐时联防整体关闭 ——
# 手机号只有 10 位数字，不加盐的 sha256 能被穷举反查，等于明文入库。
RISK_FEDERATION_PEPPER=
