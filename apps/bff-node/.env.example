NODE_ENV=development
BFF_PORT=3000
REDIS_URL=redis://127.0.0.1:6379

# Required for Telegram Mini App login (do NOT commit real token)
TELEGRAM_BOT_TOKEN=your_bot_token_here
AMMER_PAY_PROVIDER_TOKEN=your_ammer_pay_provider_token
USDT_TO_PHP_RATE=58
NACOS_SERVER_ADDR=127.0.0.1:8848
NACOS_NAMESPACE=batogo

# Huitone India payment (keep real credentials outside Git)
HUITONE_BASE_URL=https://api.huitone.ai
HUITONE_MERCHANT_ID=your_huitone_merchant_id
HUITONE_MERCHANT_KEY=your_huitone_merchant_key
HUITONE_NOTIFY_URL=https://www.188facai.com/api/v1/callback/huitone

# Optional: allow browser dev without TG initData (never enable in production)
BFF_DEV_SKIP_TELEGRAM_AUTH=false

SESSION_TTL_SECONDS=86400
MARKET_DOMAIN_MAP={"betogo666.com":"PH","betogo777.com":"PH","betogo.ph":"PH","betogo.xyz":"ID","betogo.vip":"ID","betogo888.com":"ID","betogo.cc":"ID","betogo.games":"ID","www.betogo.games":"ID"}
